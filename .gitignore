# ==========================================
# Visual Studio / C++ / Build Output .gitignore
# ==========================================

# User-specific files & local settings
*.suo
*.user
*.userosscache
*.sln.docstates
*.suo
*.VC.db
*.VC.VC.opendb
*.cachefile
*.opensdf
*.sdf

# Visual Studio directories
.vs/
.vscode/
ipch/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Bb]uild/

# Build Results & Architectures
x64/
x86/
ARM/
ARM64/
Debug/
Release/
[Dd]ebug/
[Rr]elease/

# Project temporary output from system("pause > 0")
**/0
0

# Compiled Binaries & Intermediates
*.obj
*.o
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp
*.log
*.tlog
*.idb
*.pch
*.ipch
*.iobj
*.ipdb
*.res
*.metagen
*.manifest

# Visual Studio temporary files
*.tmp
*.temp
*.bak

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
